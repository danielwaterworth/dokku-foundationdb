#!/usr/bin/env bash

_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export FOUNDATIONDB_IMAGE=${FOUNDATIONDB_IMAGE:="$(awk -F '[ :]' '/^FROM / {print $2}' "${_DIR}/Dockerfile")"}
export FOUNDATIONDB_IMAGE_VERSION=${FOUNDATIONDB_IMAGE_VERSION:="$(awk -F '[ :]' '/^FROM / {print $3}' "${_DIR}/Dockerfile")"}
export FOUNDATIONDB_ROOT=${FOUNDATIONDB_ROOT:="$DOKKU_LIB_ROOT/services/foundationdb"}
export DOKKU_LIB_HOST_ROOT=${DOKKU_LIB_HOST_ROOT:=$DOKKU_LIB_ROOT}
export FOUNDATIONDB_HOST_ROOT=${FOUNDATIONDB_HOST_ROOT:="$DOKKU_LIB_HOST_ROOT/services/foundationdb"}

export PLUGIN_COMMAND_PREFIX="foundationdb"
export PLUGIN_CONFIG_ROOT=${PLUGIN_CONFIG_ROOT:="$DOKKU_LIB_ROOT/config/$PLUGIN_COMMAND_PREFIX"}
export PLUGIN_DATA_ROOT=$FOUNDATIONDB_ROOT
export PLUGIN_DATA_HOST_ROOT=$FOUNDATIONDB_HOST_ROOT
export PLUGIN_DATASTORE_PORTS=(4500)
export PLUGIN_DATASTORE_WAIT_PORT=4500
export PLUGIN_DEFAULT_ALIAS="FDB"
export PLUGIN_ALT_ALIAS="DOKKU_FOUNDATIONDB"
export PLUGIN_DISABLE_PULL=${FOUNDATIONDB_DISABLE_PULL:=}
export PLUGIN_DISABLE_PULL_VARIABLE="FOUNDATIONDB_DISABLE_PULL"
export PLUGIN_IMAGE=$FOUNDATIONDB_IMAGE
export PLUGIN_IMAGE_VERSION=$FOUNDATIONDB_IMAGE_VERSION
export PLUGIN_SERVICE="FoundationDB"
export PLUGIN_VARIABLE="FOUNDATIONDB"
export PLUGIN_BASE_PATH="$PLUGIN_PATH"
export PLUGIN_CONFIG_SUFFIX="config"
export PLUGIN_FDB_ENTRYPOINT="${_DIR}/fdb-entrypoint"

if [[ -n $DOKKU_API_VERSION ]]; then
  export PLUGIN_BASE_PATH="$PLUGIN_ENABLED_PATH"
fi

export PLUGIN_BUSYBOX_IMAGE=${PLUGIN_BUSYBOX_IMAGE:=busybox:1.37.0-uclibc}
export FOUNDATIONDB_CONFIG_OPTIONS=${FOUNDATIONDB_CONFIG_OPTIONS:=""}
export FOUNDATIONDB_STORAGE_ENGINE=${FOUNDATIONDB_STORAGE_ENGINE:="ssd"}
